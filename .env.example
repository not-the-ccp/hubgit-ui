HUBGIT_ENVIRONMENT=development
HUBGIT_DATABASE_URL=sqlite+aiosqlite:///./.data/hubgit.db
HUBGIT_DATA_DIR=.data
HUBGIT_COOKIE_SECURE=false
HUBGIT_CORS_ORIGINS=http://localhost:3000
HUBGIT_WEB_ORIGIN=http://localhost:3000
HUBGIT_API_ORIGIN=http://localhost:8000
HUBGIT_PUBLIC_BASE_URL=http://localhost:3000

# Branding is deployment configuration. Keep the safe original identity unless
# every custom asset, URL, and authentication message has been reviewed.
HUBGIT_BRAND_NAME=HubGit
HUBGIT_BRAND_SHORT_NAME=HubGit
HUBGIT_BRAND_PRESET=hubgit
HUBGIT_BRAND_LOGO_URL=
HUBGIT_BRAND_FAVICON_URL=/favicon.svg
HUBGIT_BRAND_TITLE_TEMPLATE=%s · HubGit
HUBGIT_BRAND_PRIMARY_COLOR=#0969da
HUBGIT_BRAND_HEADER_BACKGROUND=#f6f8fa
HUBGIT_BRAND_SUPPORT_URL=
HUBGIT_BRAND_PRIVACY_URL=
HUBGIT_BRAND_TERMS_URL=
HUBGIT_BRAND_SOURCE_URL=https://github.com/not-the-ccp/hubgit-ui
HUBGIT_BRAND_AUTH_HEADING=Sign in to HubGit
HUBGIT_BRAND_PROVIDER_LABEL=GitHub
HUBGIT_BRAND_AUTH_EXPLANATION=Provider-neutral Git collaboration for self-hosted teams.
HUBGIT_BRAND_CONNECT_LABEL=Continue
HUBGIT_BRAND_OPERATOR_NOTICE=

# Provider selection and GitHub-first redirect-only authentication.
HUBGIT_PROVIDER=mock
HUBGIT_GITHUB_BASE_URL=https://github.com
HUBGIT_GITHUB_CLIENT_ID=
HUBGIT_GITHUB_CLIENT_SECRET_FILE=
HUBGIT_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Authorization-aware private cache. Automatic caching never makes a mutation
# available offline and must be backed by protected persistent storage.
HUBGIT_CACHE_DIR=.data/cache
HUBGIT_CACHE_TTL_SECONDS=300
HUBGIT_CACHE_MAX_BYTES=1073741824
HUBGIT_CACHE_AUTO_PRIVATE=true
HUBGIT_OFFLINE_AUTH_WINDOW_SECONDS=900
HUBGIT_OFFLINE_MUTATIONS=false
